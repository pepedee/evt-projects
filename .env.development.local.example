# Local Supabase stack (Postgres + Auth + Storage, all running in Docker via
# the Supabase CLI) — completely separate from the cloud project .env.local
# points at, so local dev never touches real business data.
#
# Setup:
#   1. Install Docker Desktop (required — the local stack runs as containers)
#      and make sure it's actually running before the next step.
#   2. npm run db:start
#      First run downloads images and can take a few minutes. When it
#      finishes it PRINTS these exact values — copy them in below.
#   3. Copy this file to .env.development.local (already gitignored, same as
#      .env.local) and fill in the values `supabase start` printed.
#   4. npm run dev — Next.js automatically prefers this file over .env.local
#      whenever it exists, no other change needed. Stop with npm run db:stop
#      when you're done (or leave it running between sessions).
#
# To go back to developing against the real cloud database instead, delete
# or rename .env.development.local — .env.local (the cloud config) is the
# fallback the moment this file is gone.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Not needed locally unless you're testing AI summaries/import against the
# local stack too — reuse the same key from .env.local if so.
ANTHROPIC_API_KEY=
