# Supabase — shared project, this app uses the `tracker` schema.
NEXT_PUBLIC_SUPABASE_URL=https://lfpsnhuarpdlzrsnycmo.supabase.co

# The app has no sign-in, so the server connects with the service-role key.
# SERVER ONLY. This key bypasses Row Level Security — never prefix it
# NEXT_PUBLIC_, never commit it, and keep the deployment private.
SUPABASE_SERVICE_ROLE_KEY=

# Only still needed if you restore authentication.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic — SERVER ONLY. Never prefix this with NEXT_PUBLIC_, that would
# ship your API key to every browser that loads the app.
ANTHROPIC_API_KEY=
