# Supabase — dedicated project for this app only (not shared with sibling apps).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Real auth uses the anon key above plus cookies — this key
# bypasses RLS entirely. Used for one-off admin scripts (e.g.
# supabase.auth.admin.* to create/delete test users), and by exactly one
# piece of the running app: lib/supabase/admin.ts, imported only by
# inviteMember in app/(app)/settings/actions.ts, to send real invite emails
# via auth.admin.inviteUserByEmail. Never prefix NEXT_PUBLIC_, never commit
# it, and don't reach for it anywhere else — see AGENTS.md.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string used only by scripts/apply-migration.mjs and
# scripts/check-schemas.mjs (Project settings -> Database -> Connection
# string -> URI). Not read by the Next.js app itself.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Anthropic — SERVER ONLY. Never prefix this with NEXT_PUBLIC_, that would
# ship your API key to every browser that loads the app.
ANTHROPIC_API_KEY=
