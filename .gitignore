# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real keys, but templates (*.example) are meant
# to be committed and should never get silently caught by the broad rules
.env
.env*.local
.env*
!.env*.example

# deployment
.vercel

# supabase cli scratch
supabase/.temp

# typescript
*.tsbuildinfo

# real client business documents (quotations, invoices, receipts) — never
# belongs in source control, committed or not
/_Projects/
/_Documents_Report/
